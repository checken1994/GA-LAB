# SCP system environment configuration template.
#
# Copy to .env and edit values for your deployment. `install-scp.bat` uses
# scripts/bootstrap_local_env.py so required secrets are generated instead of
# shipping weak example values.

# ── Backend ──────────────────────────────────────────────────────────────────
SCP_HOST=127.0.0.1
SCP_PORT=8000
# SCP_MODE=production

# ── Runtime / security ───────────────────────────────────────────────────────
SCP_PRODUCTION_MODE=1
SCP_DEV_MODE=0
SCP_SKIP_STARTUP_GATE=0
SCP_AUTO_APPROVE_TIER3=0
SCP_API_PROFILE=core

# External egress is fail-closed. `deny` blocks every external LLM provider.
# `allowlist` permits only exact HTTPS hostnames in SCP_LLM_EGRESS_ALLOWLIST.
# Loopback remains available for deterministic/local fixtures.
SCP_EGRESS_MODE=allowlist
SCP_LLM_EGRESS_ALLOWLIST=openrouter.ai,api.openai.com

# ── Required boot secrets ────────────────────────────────────────────────────
# Generate these locally; do not commit real values.
# SCP_JWT_SECRET=<python secrets.token_hex(32)>
# SCP_ADMIN_KEY=<python secrets.token_urlsafe(32)>
# SCP_CAPABILITY_SECRET=<python secrets.token_hex(32)>  # Required: capability token HMAC signing (GAP-09)
# SCP_AUTH_PASSWORD_FILE=.private-secrets/scp-auth-password
# SCP_AUTH_TOKEN_SECRET_FILE=secrets/scp-auth-token
# SCP_SCHEDULER_ADMIN_TOKEN_FILE=secrets/scp-scheduler-admin-token

# ── Internal service URLs ────────────────────────────────────────────────────
SCP_INTERNAL_URL=http://127.0.0.1:8000
LOOP_SCHEDULER_URL=http://127.0.0.1:3030
LLM_BRIDGE_URL=http://127.0.0.1:11435
SCP_LLM_BRIDGE_PORT=11435
# SCP_ROOT=C:\\path\\to\\GA-LAB

# ── OpenRouter / OpenAI-compatible providers ─────────────────────────────────
# Configure at least one real provider for LLM-backed behavior. The provider
# hostname must also be present in SCP_LLM_EGRESS_ALLOWLIST.
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free

# Generic OpenAI-compatible primary provider (optional).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Additional providers. Format:
# name:KEY_ENV:BASEURL_ENV:MODEL_ENV,name2:KEY_ENV:BASEURL_ENV:MODEL_ENV
SCP_LLM_FALLBACK_PROVIDERS=

# ── Per-task OpenRouter model routing ────────────────────────────────────────
OPENROUTER_MODEL_AUTOFIX=deepseek/deepseek-r1:8b
OPENROUTER_MODEL_CHAT=meta-llama/llama-3.2-3b-instruct
OPENROUTER_MODEL_JUDGE=qwen/qwen2.5-7b-instruct
OPENROUTER_MODEL_LEARNING=qwen/qwen2.5-7b-instruct
OPENROUTER_MODEL_FAST_LEARNING=meta-llama/llama-3.2-3b-instruct
OPENROUTER_MODEL_WHY=qwen/qwen2.5-7b-instruct

# ── Optional integrations ────────────────────────────────────────────────────
# NASA_API_KEY=DEMO_KEY
# SCP_CORS_ORIGINS=
# SCP_OTEL_ENABLED=0
# SCP_WHY_LLM_ENABLED=0
