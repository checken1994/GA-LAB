# SCP Environment Configuration Example
# Copy this file to .env and customize for your environment.
# All values shown here are the defaults.

# ── Backend Port ──────────────────────────────────────────────────────────────
# [GLM-AUDIT-FIX-①] Single source of truth for backend port.
# Desktop (Electron), Dashboard, and api_server.py all read SCP_PORT.
# Default: 8000 (production). Change to 8001 for test, 8002 for isolated.
SCP_PORT=8000

# ── Runtime Mode ──────────────────────────────────────────────────────────────
# auto-detected from port: 8000=production, 8001=test, 8002=isolated
# Override: SCP_MODE=production|test|unknown
# SCP_MODE=production

# ── NASA API Key ──────────────────────────────────────────────────────────────
# [GLM-AUDIT-FIX] Provide your own key from https://api.nasa.gov for higher
# rate limits (1000 req/hr vs 30 req/hr for DEMO_KEY).
# NASA_API_KEY=DEMO_KEY

# ── LLM Bridge Port ───────────────────────────────────────────────────────────
SCP_LLM_BRIDGE_PORT=11434

# ── Auth Settings ─────────────────────────────────────────────────────────────
# SCP_AUTH_PASSWORD_FILE=secrets/scp-auth-password
# SCP_AUTH_TOKEN_SECRET_FILE=secrets/scp-auth-token
# SCP_SCHEDULER_ADMIN_TOKEN_FILE=secrets/scp-scheduler-admin-token

# ── Security ──────────────────────────────────────────────────────────────────
SCP_EGRESS_MODE=deny
SCP_PRODUCTION_MODE=1
SCP_DEV_MODE=0
SCP_SKIP_STARTUP_GATE=0
SCP_AUTO_APPROVE_TIER3=0
