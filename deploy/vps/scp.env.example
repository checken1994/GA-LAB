# Copy to /etc/scp/scp.env on the VPS and edit only non-secret values here.
# Never commit the real file or put passwords/tokens in this repository.

SCP_PRODUCTION_MODE=1
SCP_HOST=127.0.0.1
SCP_PORT=8002
SCP_EGRESS_MODE=deny
SCP_FORCE_HTTPS=1
SCP_AUTH_PASSWORD_FILE=/etc/scp/secrets/auth_password

# Optional dashboard-to-service URLs. Keep internal services loopback-only.
SCP_INTERNAL_URL=http://127.0.0.1:8002
LOOP_SCHEDULER_URL=http://127.0.0.1:3030
LLM_BRIDGE_URL=http://127.0.0.1:11434

# Optional model routing. Do not put provider tokens in this file.
# Configure a server-side secret broker or a protected environment file if a
# provider integration is explicitly enabled after review.
# OPENROUTER_MODEL_CHAT=...
# OPENROUTER_MODEL_JUDGE=...
